# BilibiliDownloader —— 后端环境变量模板
# 复制为 .env 后填写（.env 不提交，见安全规范）

# 会员密钥（T04 接入）：前端提交该密钥解锁会员档能力
MEMBER_KEY=your-member-key-here

# 交付文件目录（可选，默认：项目根 downloads/）
# DOWNLOADS_DIR=downloads

# 交付直链有效期（秒，可选，默认：免费 24h / 会员 72h，PRD §5）
# FREE_DELIVERY_TTL=86400
# MEMBER_DELIVERY_TTL=259200

# 模型目录（ADR-0006，可选，默认：项目根 models/）：语音转写模型下载位置（持久资产）
# MODELS_DIR=models
# 模型字幕缓存目录（可选，默认：models/subtitles/）：转录段 JSON 按 TTL 清理
# SUBTITLES_DIR=models/subtitles

# AI 视频总结（ADR-0005，可选）
# B 站登录 Cookie（服务端自备，仅供获取官方字幕；不配置则自动回退音频转写）
# 注意：绝不收集用户浏览器 Cookie，此 Cookie 仅存在于服务端环境
# BILI_COOKIE=SESSDATA=xxxx; bili_jct=xxxx; buvid3=xxxx

# LLM 调用（DeepSeek，openai 兼容 SDK；未配置 LLM_API_KEY 时回退 DEEPSEEK_API_KEY）
LLM_API_KEY=your-llm-api-key-here
# LLM_BASE_URL=https://api.deepseek.com
# LLM_MODEL=deepseek-chat

# ASR 回退转写（SenseVoice + fsmn-vad，统一下载到项目 models/ 目录）
# ASR_MODEL=iic/SenseVoiceSmall
# ASR_VAD_MODEL=iic/speech_fsmn_vad_zh-cn-16k-common-pytorch
# ASR_CHUNK_SECONDS=600

# ASR VAD 断句粒度 (ms): 句尾静音阈值, 两句话间隔低于该值会被合并成一条
# 字幕 (默认 800 = 官方默认; 台词间隔短/快速对话调低如 500 断出更多短句,
# 过低如 300 会把正常句子从中切断)
# ASR_VAD_MAX_END_SILENCE_MS=800
# ASR_VAD_SPEECH_TO_SIL_THRES_MS= (语音转静音最小时长, 留空 = 模型默认)
