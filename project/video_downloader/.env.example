# BilibiliDownloader —— 后端环境变量模板
# 复制为 .env 后填写（.env 不提交，见安全规范）

# 会员密钥（T04 接入）：前端提交该密钥解锁会员档能力
MEMBER_KEY=your-member-key-here

# 交付文件目录（可选，默认：项目根 downloads/）
# DOWNLOADS_DIR=downloads

# 交付直链有效期（秒，可选，默认：免费 24h / 会员 72h，PRD §5）
# FREE_DELIVERY_TTL=86400
# MEMBER_DELIVERY_TTL=259200

# AI 视频总结（ADR-0005，可选）
# B 站登录 Cookie（服务端自备，仅供获取官方字幕；不配置则自动回退音频转写）
# 注意：绝不收集用户浏览器 Cookie，此 Cookie 仅存在于服务端环境
# BILI_COOKIE=SESSDATA=xxxx; bili_jct=xxxx; buvid3=xxxx

# LLM 调用（DeepSeek，openai 兼容 SDK；未配置 LLM_API_KEY 时回退 DEEPSEEK_API_KEY）
LLM_API_KEY=your-llm-api-key-here
# LLM_BASE_URL=https://api.deepseek.com
# LLM_MODEL=deepseek-chat

# ASR 回退转写（SenseVoice，模型首次使用自动下载至缓存）
# ASR_MODEL=iic/SenseVoiceSmall
# ASR_CHUNK_SECONDS=600
