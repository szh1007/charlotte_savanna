# ============================================================
# rag_knowledge 环境变量模板
# 复制为 .env 并填写真实值: cp .env.example .env
# 注意: .env 包含真实密钥, 切勿提交到版本控制
# ============================================================

# --- Model (DeepSeek) ---
# OpenAI 兼容 API 地址
RK_DEEPSEEK_BASE_URL=https://api.deepseek.com
# DeepSeek API Key
RK_DEEPSEEK_API_KEY=sk-your-deepseek-api-key
# 视觉语言模型 (图片语义化 / PDF 高精度解析兜底)
RK_VL_MODEL=deepseek-v4-flash-vision-exp
# 对话模型
RK_LLM_DEFAULT_MODEL=deepseek-v4-flash
# 生成温度, 低温度保证输出确定性
RK_LLM_DEFAULT_TEMPERATURE=0.1

# --- MinerU (PDF 解析服务) ---
# MinerU 服务地址, 官方 API v4 版本
RK_MINERU_BASE_URL=https://mineru.net/api/v4
# MinerU API Token
RK_MINERU_API_TOKEN=your-mineru-api-token
# 模型版本 (vlm = 视觉语言模型, PDF/图片高精度解析)
RK_MINERU_MODEL_VISION=vlm
# 解析任务轮询最大超时时间, 超过则判定失败 (一个 PDF 约等于 1 秒)
RK_MINERU_POLL_TIMEOUT_SECONDS=600
# 解析任务轮询间隔
RK_MINERU_POLL_INTERVAL_SECONDS=3
# 文件下载超时时间
RK_MINERU_DOWNLOAD_TIMEOUT_SECONDS=30

# --- MinIO (对象存储, 文档图片) ---
RK_MINIO_ENDPOINT=127.0.0.1:19000
RK_MINIO_ACCESS_KEY=minioadmin
RK_MINIO_SECRET_KEY=minioadmin
RK_MINIO_BUCKET_NAME=rk-files
# 图片在桶内的存放目录前缀
RK_MINIO_IMG_DIR=upload-images
# 是否使用 HTTPS (True/False)
RK_MINIO_SECURE=False

# --- Milvus (向量数据库) ---
RK_MILVUS_URL=http://localhost:19530
# 文档 chunks 集合名
RK_CHUNKS_COLLECTION=rk_chunks
# 主体名称集合名
RK_ITEM_NAME_COLLECTION=rk_item_names
# 向量维度 (BGE-M3 稠密向量为 1024, 与模型保持一致)
RK_EMBEDDING_DIM=1024

# --- MongoDB (会话历史) ---
RK_MONGO_URL=mongodb://127.0.0.1:27017
RK_MONGO_DB_NAME=rk_chat_history

# --- Logger ---
# 控制台日志开关/级别 (DEBUG / INFO / WARNING / ERROR)
RK_LOG_CONSOLE_ENABLE=True
RK_LOG_CONSOLE_LEVEL=DEBUG
# 文件日志开关/级别
RK_LOG_FILE_ENABLE=True
RK_LOG_FILE_LEVEL=INFO
# 日志文件保留时长
RK_LOG_FILE_RETENTION=7 days

# ---------- Embedding (BGE-M3) ----------
# 模型来源优先级: RK_BGE_M3_PATH > RK_BGE_M3 > 默认 "BAAI/bge-m3" (自动下载)
# 本地已下载模型时填本地目录路径, 例如: D:/modelscope/models/BAAI/bge-m3
RK_BGE_M3_PATH=
# 也可填 ModelScope/HuggingFace 模型名或在线地址
RK_BGE_M3=
# 推理设备 (cpu / cuda), 默认 cpu
RK_BGE_DEVICE=cpu
# 是否启用 FP16 (1/0; 注意: cpu 不支持 fp16 加速)
RK_BGE_FP16=0

# ---------- Reranker (BGE-Reranker-Large) ----------
# 本地已下载模型时填本地目录路径, 例如: D:/modelscope/models/BAAI/bge-reranker-large
RK_BGE_RERANKER_LARGE=
# 推理设备 (cpu / cuda), 默认 cpu
RK_BGE_RERANKER_DEVICE=cpu
# 是否启用 FP16 (1/0; 注意: cpu 不支持 fp16 加速)
RK_BGE_RERANKER_FP16=0

# ----- Tavily -----
TAVILY_API_KEY=tvly-your-tavily-api-key
