# CharPlot FastAPI AI 能力端环境变量模板
# 复制为 .env 并填入实际值 (.env 不提交)

# 共享 Redis (与 Django 侧同一实例, 任务状态 / 缓存)
REDIS_URL="redis://127.0.0.1:6379/0"

# ----- 知识管道 (Issue 07, 与根 .env 共享) -----
# LLM 模型名 (init_chat_model 格式: deepseek:xxx), 从根 .env 读取
# DEEPSEEK_MODEL_NAME / DEEPSEEK_API_KEY / DEEPSEEK_API_BASE
# Tavily 联网搜索 key, 未配置时网络检索源自动降级跳过 (Context7/文档源不受影响)
# TAVILY_API_KEY

# 可选覆盖 (默认值见 api/config.py):
# CHARPLOT_CONTEXT7_BASE_URL="https://context7.com/api"      # Context7 公开 API (v2 相对路径)
# CHARPLOT_CONTEXT7_MAX_DOCS=5                               # 每库文档片段上限
# CHARPLOT_LINK_FETCH_TIMEOUT=10                             # 链接抓取超时 (秒)
# CHARPLOT_LLM_RETRIES=1                                     # LLM 分析/解构失败重试次数
