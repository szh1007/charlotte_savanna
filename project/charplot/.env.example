# CharPlot FastAPI AI 能力端环境变量模板
# 复制为 .env 并填入实际值 (.env 不提交)

# ----- 知识管道 -----
# DeepSeek 模型名 (init_chat_model 格式: deepseek:xxx), 未配置时管道不可用
CHARPLOT_DEEPSEEK_MODEL_NAME="deepseek:deepseek-v4-flash"
CHARPLOT_DEEPSEEK_API_BASE="https://api.deepseek.com"
CHARPLOT_DEEPSEEK_API_KEY="sk-your-deepseek-api-key"

# ----- Tavily 联网搜索 -----
# 未配置时网络检索源自动降级跳过 (Context7/文档源不受影响)
CHARPLOT_TAVILY_API_KEY="tvly-your-tavily-api-key"

# ----- CharPlot 服务间认证 -----
# FastAPI 调 Django 内部端点 (图谱落库/失败标记) 用共享 token; Django 侧与
# FastAPI 侧 .env 必须配置为同一值, 未配置则内部端点拒绝一切请求
CHARPLOT_INTERNAL_TOKEN="your-charplot-internal-token"
CHARPLOT_DJANGO_BASE_URL="http://127.0.0.1:8000"

# ----- Redis (任务状态) -----
# 与 Django 侧同一实例但独立库 (Django 缓存用根 .env 的 REDIS_URL /0,
# CharPlot 任务状态 / SSE 用本变量 /4), 互不污染
CHARPLOT_REDIS_URL="redis://127.0.0.1:6379/4"

# 可选覆盖 (默认值见 api/config.py):
# Context7 公开 API (v2 相对路径)
# 每库文档片段上限
# 链接抓取超时 (秒)
# LLM 分析/解构失败重试次数
CHARPLOT_CONTEXT7_BASE_URL="https://context7.com/api"
CHARPLOT_CONTEXT7_MAX_DOCS=5
CHARPLOT_LINK_FETCH_TIMEOUT=10
CHARPLOT_LLM_RETRIES=1

# ----- CharPlot RAG -----
# Milvus 向量库地址
CHARPLOT_MILVUS_URL="http://localhost:19530"
# embedding 模型抽象: bge-m3 = 本地 BGE-M3 (稠密+稀疏一次出, 首次运行下载 ~2GB)
CHARPLOT_EMBEDDING_MODEL="bge-m3"
CHARPLOT_EMBEDDING_MODEL_NAME="BAAI/bge-m3"
CHARPLOT_EMBEDDING_DEVICE="cpu"
CHARPLOT_EMBEDDING_FP16="false"
CHARPLOT_EMBEDDING_DIM="1024"
# 文档切分参数 (默认 md/txt 档; pdf/docx/pptx/html 按类型自动调优)
CHARPLOT_CHUNK_SIZE="500"
CHARPLOT_CHUNK_OVERLAP="50"
# rerank 模型 (必配链路; 留空 = 降级不精排, 保留召回顺序)
CHARPLOT_RERANKER_MODEL="BAAI/bge-reranker-v2-m3"
CHARPLOT_RERANKER_DEVICE="cpu"
CHARPLOT_RERANKER_FP16="false"
# 检索参数: 混合召回量 (精排前) / 精排后 Top-K
CHARPLOT_RETRIEVE_TOP_K="20"
CHARPLOT_RERANK_TOP_K="5"
# 检索前 LLM 改写查询 (改写失败自动降级原查询)
CHARPLOT_QUERY_REWRITE="true"
