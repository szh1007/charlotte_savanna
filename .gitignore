# --- Python 字节码 ---
__pycache__/
*.py[cod]
*.pyo
*.egg-info/
*.egg
dist/
build/

# --- 虚拟环境 ---
.venv/
venv/
env/

# --- 环境变量（含敏感信息） ---
.env
# 通用忽略: 各子项目里放私有配置的 yaml（如 rag_text2sql 的 conf/*.yaml）
*.yaml
# 例外: 这一份**必须进仓库** —— 它是"当前默认用哪一版提示词"的声明, 缺了它
# 助手起不来 (启动期报错, 不静默退回). 上面那条通用规则会连它一起挡掉.
!CharApp/minimall/prompt/manifest.yaml

# --- IDE / 编辑器 ---
.idea/
.vscode/*
!.vscode/settings.json
*.swp
*.swo
*~

