# ============================================
# charlotte_savanna 环境变量配置模板
# ============================================

# ----- DeepSeek (Chat Model) -----
DEEPSEEK_API_BASE="https://api.deepseek.com"
DEEPSEEK_API_KEY="sk-your-deepseek-api-key"
DEEPSEEK_MODEL_NAME="deepseek:deepseek-flash"

# ----- CloseAI (Embedding Model) -----
CLOSEAI_BASE_URL="https://api.openai-proxy.org/v1"
CLOSEAI_API_KEY="sk-your-closeai-api-key"
CLOSEAI_EMBEDDING_MODEL="openai:text-embedding-3-large"

# ----- MySQL -----
MYSQL_USERNAME="root"
MYSQL_PASSWORD="your-mysql-password"
MYSQL_HOST="127.0.0.1"
MYSQL_PORT="3306"
MYSQL_NAME="charlotte"

# ----- PostgreSQL -----
PGSQL_USERNAME="charlotte"
PGSQL_PASSWORD="your-pgsql-password"
PGSQL_HOST="127.0.0.1"
PGSQL_PORT="5432"
PGSQL_NAME="charlotte"

# ----- Redis -----
REDIS_URL="redis://127.0.0.1:6379/0"

# ----- Milvus -----
MILVUS_URL="http://localhost:19530"
MILVUS_DATABASE_NAME="charlotte"
MILVUS_COLLECTION_NAME="test"

# ----- Django -----
DJANGO_SECRET_KEY="your-secret-key-here"
DJANGO_ALLOWED_HOSTS="localhost,127.0.0.1"
DJANGO_RUNSERVER_HIDE_WARNING=true

# ----- Tavily -----
TAVILY_API_KEY="tvly-your-tavily-api-key"

# ----- LangSmith -----
LANGSMITH_ENDPOINT="https://api.smith.langchain.com"
LANGSMITH_API_KEY="lsv2_pt_your-langsmith-api-key"
LANGSMITH_PROJECT="charlotte_savanna"
LANGSMITH_TRACING=true

# ----- CharPlot Permission -----
CHARPLOT_INTERNAL_TOKEN="your-charplot-internal-token"

# ----- CharAgent 快照存储 (checkpoint/, ADR-0002) -----
# 换后端只改 CHARAGENT_CHECKPOINT_BACKEND 这一个值, 代码一行不动; 三个可选值:
#   memory   = 进程内字典, 重启就没 (测试与单机玩)
#   redis    = 快、可裁剪、会过期 (需本机 Redis)
#   postgres = 强一致、留全历史、能翻历史与回溯分叉 (需本机 Postgres)
CHARAGENT_CHECKPOINT_BACKEND="memory"
# Redis 键前缀与存活秒数 (不填 = 不过期)
CHARAGENT_CHECKPOINT_KEY_PREFIX="charagent"
CHARAGENT_CHECKPOINT_TTL_SECONDS=""
# Redis 模式: history = 全历史 (默认) / latest = 只留最新一帧
CHARAGENT_CHECKPOINT_REDIS_MODE="history"
# history 模式最多留几帧 (不填 = 不裁剪)
CHARAGENT_CHECKPOINT_REDIS_MAX_FRAMES=""
# Redis 连接串 (不填则回退用上面的 REDIS_URL)
CHARAGENT_CHECKPOINT_REDIS_URL=""
# Postgres 连接串 (不填则由上面的 PGSQL_* 拼)
CHARAGENT_CHECKPOINT_POSTGRES_DSN=""

# ----- CharAgent 数据层 (db/, alembic 迁移与仓储) -----
# 连接串 (不填则由上面的 PGSQL_* 拼); CHARAGENT_DB_ECHO=true 打印 SQL, 排查用
CHARAGENT_DB_DSN=""
CHARAGENT_DB_ECHO="false"
