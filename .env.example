# ============================================
# charlotte_savanna 环境变量配置模板
# ============================================

# ----- DeepSeek (Chat Model) -----
DEEPSEEK_API_BASE="https://api.deepseek.com"
DEEPSEEK_API_KEY="sk-your-deepseek-api-key"
DEEPSEEK_MODEL_NAME="deepseek:deepseek-flash"

# ----- CloseAI (Embedding Model / Chat 备份模型) -----
CLOSEAI_BASE_URL="https://api.openai-proxy.org/v1"
CLOSEAI_API_KEY="sk-your-closeai-api-key"
CLOSEAI_EMBEDDING_MODEL="openai:text-embedding-3-large"
# CLOSEAI_CHAT_MODEL = **备份模型** (困难点 #14 的 failover): 配了它, 模型层就是
# 「主备两家」—— 主模型 (上面的 DEEPSEEK_*) 连续失败到阈值跳闸之后, 这一趟改走
# 这里配的这家. 为什么是另一家而不是同一家的另一档: 同源故障时两个会一起挂,
# 等于没切 (ADR-0025). **上面三样 + 这一样齐全才算配了备份**, 少一样就当没配
# (备份是加固, 不是启动前提). 换家也要跟着换价目表: 记账按**实际答话**的模型名
# 查价 (见下面 CHARAGENT_MODEL_PRICES 那段).
# 一句**方言提醒** (2026-10-05 真机实测): 这一家带 function tools 时必须显式关掉思考
# (`reasoning_effort="none"`), 否则 400 —— 那条已经写在装配代码里 (`client/app.py`),
# 换一家备份端点时这一条要重新看.
CLOSEAI_CHAT_MODEL="openai:gpt-6-luna"

# ----- MySQL -----
MYSQL_USERNAME="root"
MYSQL_PASSWORD="your-mysql-password"
MYSQL_HOST="127.0.0.1"
MYSQL_PORT="3306"
MYSQL_NAME="charlotte"

# ----- PostgreSQL -----
PGSQL_USERNAME="charlotte"
PGSQL_PASSWORD="your-pgsql-password"
PGSQL_HOST="127.0.0.1"
PGSQL_PORT="5432"
PGSQL_NAME="charlotte"

# ----- Redis -----
REDIS_URL="redis://127.0.0.1:6379/0"

# ----- Milvus -----
MILVUS_URL="http://localhost:19530"
MILVUS_DATABASE_NAME="charlotte"
MILVUS_COLLECTION_NAME="test"

# ----- Django -----
DJANGO_SECRET_KEY="your-secret-key-here"
DJANGO_ALLOWED_HOSTS="localhost,127.0.0.1"
DJANGO_RUNSERVER_HIDE_WARNING=true

# ----- Tavily -----
TAVILY_API_KEY="tvly-your-tavily-api-key"

# ----- LangSmith -----
LANGSMITH_ENDPOINT="https://api.smith.langchain.com"
LANGSMITH_API_KEY="lsv2_pt_your-langsmith-api-key"
LANGSMITH_PROJECT="charlotte_savanna"
LANGSMITH_TRACING=true

# ----- CharPlot Permission -----
CHARPLOT_INTERNAL_TOKEN="your-charplot-internal-token"

# ----- CharApp 电商智能客服 -----
# 内部令牌: 商城侧 (Django) 与助手侧同值 —— 一处配错, 两边都拒绝 (fail closed)
CHARAPP_INTERNAL_TOKEN="your-charapp-internal-token"
# 助手打商城的内部端点地址
CHARAPP_BASE_URL="http://127.0.0.1:8000/api/minimall/agent/"
# 监听地址默认只给本机: 这个服务面向同机的 Django 转发层, 不直接对外 (PRD §4.10)
CHARAPP_SERVER_HOST="127.0.0.1"
CHARAPP_SERVER_PORT="1007"
# 反向的那一跳: Django 客服页面 (BFF) 把问句转发到这里 —— 与上面两行是一对
# (那个服务监听在什么地址, 这里就填什么). 不填 = 用同一个默认值
CHARAPP_SERVER_URL="http://127.0.0.1:1007"
# 思考模式开关 (**服务端专用**, 命令行入口用 --no-thinking)
# 不填 = 不传该参数, 走上游默认 (开启); 关掉填 false (省 token 也更快)
CHARAPP_THINKING=""

# 上下文压缩的五个旋钮 (两个入口同源: 命令行也读这套).
#
# 它们管的是「这一次请求发给模型的那份上下文有多大」—— 账本 (快照) 与用户看到的
# 记录**永不压缩**, 变的只是这一跳. 全部有默认值, 不填也能跑 (下面写的就是默认).
#   起压阈值: 估算到这个数才压 (压完落到水位线以下才停手)
CHARAPP_CONTEXT_MAX_TOKENS="32000"
#   留最近几轮**完整**对话 (一轮 = 一个提问连同为它做的全部工具往返)
CHARAPP_CONTEXT_KEEP_TURNS="6"
#   更老的工具结果正文截到这个字符数 (正在回答的那一轮不截)
CHARAPP_CONTEXT_TOOL_LIMIT="2000"
#   摘要开关: 关掉 = 只裁剪 + 截断, 压缩这一步不再花模型调用 (on / off)
CHARAPP_CONTEXT_SUMMARY="on"
#   水位线: 压到阈值的这个比例以下才停手 (0 < x < 1, 越界启动期报错)
#   滞回用: 只按下限压的话, 下一次请求立刻又超线, 于是每次都压、每次都花钱
CHARAPP_CONTEXT_WATERMARK="0.7"

# 离线跑分 (L4) 模拟买家确认时要注入的支付密码.
#
# **只有跑分器读它** —— 生产那两个入口一个字都不看: 真买家在确认卡上现输, 那个值
# 走恢复请求的正文, 不进环境变量 (ADR-0015: 密码只走一次性载荷, 从不落库).
# 它只活在这一趟恢复里: 不进题面、不进报告、不进记录表 (跑分这条链上没有日志出口;
# 将来若给跑分入口加输出, 那一个必须走 minimall/log_redaction.py 的
# `redacting_writer`, 否则 `**.payment_password` 那条打码规则就被绕过去了).
# 不填 = 代付那条路走不通 (要密码的那一跑会记成「模拟确认失败」), 别的题照跑不误.
CHARAPP_EVAL_PAYMENT_PASSWORD="your-eval-payment-password"

# ----- CharApp 知识库 (L5: 政策问答的 RAG 链路) -----
# 一条链路的三个前提: 向量库 / 两个本地模型 / 检索参数. 全部有默认值, 不填也能跑
# (默认就是下面写的这些), 但**默认路径指到本机的 modelscope 下载目录** —— 换机器
# 只需要改 CHARAPP_MODELSCOPE_ROOT 这一行.
#
# Milvus 地址 (用本机实例即可; collection 名固定为 ca_knowledge, 不在这里配)
CHARAPP_MILVUS_URL="http://localhost:19530"
# 本地模型的根目录 (modelscope 平铺布局: {root}/models/{org}/{name})
CHARAPP_MODELSCOPE_ROOT="D:/__WorkSpace__/modelscope"
# Embedding: 注册名 (当前只有 bge-m3) + 模型引用 (org/name 或一个已存在的目录).
# 加载前会校验本地目录存在 —— **缺失时报错, 不会自动从 HuggingFace 下载**;
# 报错信息里带着可照抄的 modelscope 下载命令.
CHARAPP_EMBEDDING_MODEL="bge-m3"
CHARAPP_EMBEDDING_MODEL_NAME="BAAI/bge-m3"
CHARAPP_EMBEDDING_DEVICE="cpu"
CHARAPP_EMBEDDING_FP16="false"
# 稠密向量维度 (bge-m3 = 1024); 换模型要重建索引
CHARAPP_EMBEDDING_DIM="1024"
# 精排: 本地 bge-reranker-v2-m3 (同样只认本地). **缺失时降级不精排** (warning 明示,
# 检索照常工作) —— 精排是增强, 不是链路前提.
CHARAPP_RERANKER_MODEL="BAAI/bge-reranker-v2-m3"
CHARAPP_RERANKER_DEVICE="cpu"
CHARAPP_RERANKER_FP16="false"
# 检索参数: 混合召回量 (精排前) 与精排后给模型的片段数.
# 默认 5 / 3 是被**当前语料规模**钉住的: 库里 6 篇文章、7 条 chunk, 召回 5 条已经
# 覆盖大半个库, 而精排在 CPU 上逐对前向 (实测约 1.1 秒/对, bge-reranker-v2-m3,
# 8 线程) —— 多一条候选就多一秒多的等待. 语料涨上去时这两个数要一起往上调; 精排
# 太慢的另一条路是把 CHARAPP_RERANKER_MODEL 留空, 走降级不精排.
CHARAPP_RETRIEVE_TOP_K="5"
CHARAPP_RERANK_TOP_K="3"
# Query rewriting: 检索前用 LLM 把口语化查询补全 (改写失败自动降级原查询)
CHARAPP_QUERY_REWRITE="on"
#
# 两个本地模型会**常驻内存**: 服务启动后后台预热 (见 knowledge/prewarm.py),
# 于是"第一问"不必等模型加载 (实测预热 7~8 秒), 代价是常驻内存 —— 跑过一轮真实
# 检索之后 RSS 约 3.4GB (bge-m3 + bge-reranker-v2-m3, CPU fp32, 2026-10-04 实测).

# ----- CharAgent 快照存储 (checkpoint/) -----
# 换后端只改 CHARAGENT_CHECKPOINT_BACKEND 这一个值, 代码一行不动; 三个可选值:
#   memory   = 进程内字典, 重启就没 (**只用于早期测试**)
#   redis    = 快、可裁剪、会过期 (需本机 Redis)
#   postgres = 强一致、留全历史、能翻历史与回溯分叉 (需本机 Postgres)
#
# 本业务跑 postgres (2026-09-23 起): 内存后端下「重启即清空」是常态, 而 L2.5 的
# 验收是「重启之后历史还在, 且模型接着上文答」—— 那需要**两样都持久**: 快照 (模型
# 上下文的水合来源, 就是这一行) 与记录表 (下一节那个 DSN, 前端历史与列表的来源).
# 换环境先建表: cd CharAgent && alembic upgrade head (配置见 alembic.ini).
CHARAGENT_CHECKPOINT_BACKEND="postgres"
# Redis 键前缀与存活秒数 (不填 = 不过期)
CHARAGENT_CHECKPOINT_KEY_PREFIX="charagent"
CHARAGENT_CHECKPOINT_TTL_SECONDS=""
# Redis 模式: history = 全历史 (默认) / latest = 只留最新一帧
CHARAGENT_CHECKPOINT_REDIS_MODE="history"
# history 模式最多留几帧 (不填 = 不裁剪)
CHARAGENT_CHECKPOINT_REDIS_MAX_FRAMES=""
# Redis 连接串 (不填则回退用上面的 REDIS_URL)
CHARAGENT_CHECKPOINT_REDIS_URL=""
# Postgres 连接串 (不填则由上面的 PGSQL_* 拼)
CHARAGENT_CHECKPOINT_POSTGRES_DSN=""

# ----- CharAgent 数据层 (db/, alembic 迁移与仓储) -----
# 连接串 (不填则由上面的 PGSQL_* 拼); CHARAGENT_DB_ECHO=true 打印 SQL, 排查用
CHARAGENT_DB_DSN=""
CHARAGENT_DB_ECHO="false"

# ----- CharAgent 成本价目表 (db/cost.py; 运行**收尾那一刻**按它算好写进 runs) -----
# 三段: timezone (IANA 名) / peak_windows (峰时段, 半开区间) / models (模型 -> 价).
# 每个模型可以写**三档** (全天一个价) 或 **peak/valley 两套**; 用两套就**必须**给
# 时区与峰窗 (不给会用默认规则静默算错钱, 所以那里直接报错). 单位一律是**每百万
# token** 的金额, 数字抄供应商价目表即可; 币种必须与屏幕上那个 ¥ 一致 (框架不换算).
# 峰谷按**运行的开始时刻**判定, 工作日看中国日历 (法定节假日不算、调休上班的周末算),
# 日历数据每年 11 月前后随依赖更新 (chinesecalendar, 见 charagent[pricing]).
# 下面这行是**示例值** (照抄即生效): 主模型 deepseek-flash 的已发布价 (2026-09-10
# 调价后), 峰 2 / 0.04 / 8, 谷 1 / 0.02 / 4; 备份模型 gpt-6-luna 写的是**三档**
# (全天一个价, 人家不分峰谷), 照的是它的价目表. 想「不配价」就把这一行删掉或留空
# —— 那时代码的默认是空表: 运行照跑, 金额留空并写明原因 (绝不写 0).
# 表是**按模型名查**的 (键就是 runs.model 那一列): 熔断切过模型的那几趟按备份的名字
# 查价; 一趟里两家都用过 (主模型先答过、后来才跳闸) 则记组合名 `主+备` —— 表里查
# 不到, 于是金额留空并写明原因, 而不是按其中一家的单价算一笔对不上的账 (ADR-0025).
CHARAGENT_MODEL_PRICES='{"timezone": "Asia/Shanghai", "peak_windows": [["09:00", "12:00"], ["14:00", "18:00"]], "models": {"deepseek-flash": {"peak": {"cache_miss": 2, "cache_hit": 0.04, "output": 8}, "valley": {"cache_miss": 1, "cache_hit": 0.02, "output": 4}}, "gpt-6-luna": {"cache_miss": 1, "cache_hit": 0.1, "output": 5}}}'
