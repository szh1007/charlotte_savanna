# ============================================
# charlotte_savanna 环境变量配置模板
# ============================================
# 使用说明：
#   1. 复制此文件为 .env：  cp .env.example .env
#   2. 填入真实的 API Key 和配置值
#   3. .env 文件已在 .gitignore 中，不会被提交
# ============================================

# ----- DeepSeek (Chat Model) -----
# model = init_chat_model(
#     model=os.getenv("DEEPSEEK_MODEL_NAME", ""),
#     extra_body={"thinking": {"type": "disabled"}},
# )
DEEPSEEK_API_BASE="https://api.deepseek.com"
DEEPSEEK_API_KEY="sk-your-deepseek-api-key"
DEEPSEEK_MODEL_NAME="deepseek:deepseek-v4-flash"

# ----- CloseAI (Embedding Model) -----
# embedding_model = init_embeddings(
#     model=os.getenv("CLOSEAI_EMBEDDING_MODEL", ""),
#     api_key=os.getenv("CLOSEAI_API_KEY", ""),
#     base_url=os.getenv("CLOSEAI_BASE_URL", ""),
# )
CLOSEAI_BASE_URL="https://api.openai-proxy.org/v1"
CLOSEAI_API_KEY="sk-your-closeai-api-key"
CLOSEAI_EMBEDDING_MODEL="openai:text-embedding-3-large"

# ----- MySQL -----
MYSQL_USERNAME="root"
MYSQL_PASSWORD="your-mysql-password"
MYSQL_HOST="127.0.0.1"
MYSQL_PORT="3306"
MYSQL_NAME="charlotte"

# ----- PostgreSQL -----
PGSQL_USERNAME="charlotte"
PGSQL_PASSWORD="your-pgsql-password"
PGSQL_HOST="127.0.0.1"
PGSQL_PORT="5432"
PGSQL_NAME="charlotte"

# ----- Redis -----
REDIS_URL="redis://127.0.0.1:6379/0"

# ----- Milvus -----
MILVUS_URL="http://localhost:19530"
MILVUS_DATABASE_NAME="charlotte"
MILVUS_COLLECTION_NAME="test"

# ----- CharPlot RAG (Issue 10, project/charplot/rag/) -----
# embedding 模型抽象: bge-m3 = 本地 BGE-M3 (稠密+稀疏一次出, 首次运行下载 ~2GB)
CHARPLOT_EMBEDDING_MODEL="bge-m3"
CHARPLOT_EMBEDDING_MODEL_NAME="BAAI/bge-m3"
CHARPLOT_EMBEDDING_DEVICE="cpu"
CHARPLOT_EMBEDDING_FP16="false"
CHARPLOT_EMBEDDING_DIM="1024"
# 文档切分参数 (默认 md/txt 档; pdf/docx/pptx/html 按类型自动调优)
CHARPLOT_CHUNK_SIZE="500"
CHARPLOT_CHUNK_OVERLAP="50"
# rerank 模型 (必配链路; 留空 = 降级不精排, 保留召回顺序)
CHARPLOT_RERANKER_MODEL="BAAI/bge-reranker-v2-m3"
CHARPLOT_RERANKER_DEVICE="cpu"
CHARPLOT_RERANKER_FP16="false"
# 检索参数: 混合召回量 (精排前) / 精排后 Top-K
CHARPLOT_RETRIEVE_TOP_K="20"
CHARPLOT_RERANK_TOP_K="5"
# 检索前 LLM 改写查询 (改写失败自动降级原查询)
CHARPLOT_QUERY_REWRITE="true"

# ----- Django -----
DJANGO_SECRET_KEY="your-secret-key-here"
DJANGO_ALLOWED_HOSTS="localhost,127.0.0.1"
DJANGO_RUNSERVER_HIDE_WARNING=true

# ----- Tavily -----
TAVILY_API_KEY="tvly-your-tavily-api-key"

# ----- LangSmith -----
LANGSMITH_ENDPOINT="https://api.smith.langchain.com"
LANGSMITH_API_KEY="lsv2_pt_your-langsmith-api-key"
LANGSMITH_PROJECT="charlotte_savanna"
LANGSMITH_TRACING=true
