# ============================================
# charlotte_savanna 环境变量配置模板
# ============================================
# 使用说明：
#   1. 复制此文件为 .env：  cp .env.example .env
#   2. 填入真实的 API Key 和配置值
#   3. .env 文件已在 .gitignore 中，不会被提交
# ============================================

# --- Django 配置 ---
DJANGO_SECRET_KEY=your-secret-key-here
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_RUNSERVER_HIDE_WARNING=true

# --- OpenAI (LangChain 使用) ---
OPENAI_BASE_URL=https://api.openai-proxy.org/v1
OPENAI_API_KEY=sk-your-openai-api-key

# --- DeepSeek (LangChain OpenAI 兼容) ---
DEEPSEEK_API_BASE=https://api.deepseek.com
DEEPSEEK_API_KEY=sk-your-deepseek-api-key

# --- Anthropic / DeepSeek (Claude Code 后端) ---
ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic
ANTHROPIC_AUTH_TOKEN=sk-your-deepseek-api-key
ANTHROPIC_MODEL=deepseek-v4-pro[1m]
ANTHROPIC_DEFAULT_OPUS_MODEL=deepseek-v4-pro[1m]
ANTHROPIC_DEFAULT_SONNET_MODEL=deepseek-v4-pro[1m]
ANTHROPIC_DEFAULT_HAIKU_MODEL=deepseek-v4-flash

# --- Tavily Search (Agent 搜索工具) ---
TAVILY_API_KEY=tvly-your-tavily-api-key

# --- LangSmith (LLM 可观测性) ---
LANGSMITH_PROJECT=charlotte_savanna
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=lsv2_pt-your-langsmith-api-key

# --- RAG 测试用 ---
RAG_TEST_URL=https://example.com
RAG_TEST_UA=Mozilla/5.0

# --- MySQL 数据库 ---
DB_USERNAME=root
DB_PASSWORD=your-db-password
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=charlotte
DB_NAME_FASTAPI=miniblog

# --- PostgreSQL 数据库 ---
PG_DB_USERNAME=charlotte
PG_DB_PASSWORD=your-db-password
PG_DB_HOST=127.0.0.1
PG_DB_PORT=5432
PG_DB_NAME=charlotte
PG_DB_NAME_FASTAPI=miniblog

# --- Redis 缓存 ---
REDIS_URL=redis://127.0.0.1:6379/1

# --- Milvus 向量数据库 ---
MILVUS_URL=http://localhost:19530
MILVUS_DB_NAME=charlotte
MILVUS_COLLECTION_NAME=docs
EMBEDDING_MODEL=text-embedding-3-large
EMBEDDING_DIM=3072
